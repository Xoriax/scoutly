# Source de données active : recherche-entreprises (gratuite, défaut) | pappers
COMPANY_PROVIDER=recherche-entreprises

# User-Agent envoyé aux API (recommandé par l'API Recherche d'entreprises)
API_USER_AGENT=scoutly/0.1 (contact@example.com)

# Requêtes par seconde vers l'API Recherche d'entreprises (limite officielle : 7/s par IP)
RECHERCHE_ENTREPRISES_RPS=5

# Nombre maximal de lignes par export Excel/CSV (plafond : 10000)
EXPORT_MAX_ROWS=1000

# Durée maximale de collecte d'un export, en millisecondes
EXPORT_TIMEOUT_MS=90000

# Protection de l'accès (authentification HTTP Basic).
# Laisser vide en développement ; à définir en production pour réserver l'accès.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Base SQLite (recherches sauvegardées, suivi des prospects)
DATABASE_PATH=data/scoutly.db

# Adresse publique de l'application (liens dans les emails d'alerte)
APP_URL=https://scoutly.mondomaine.fr

# Alertes « nouvelles entreprises »
# Jeton exigé par POST /api/alertes/run (appelée par la tâche planifiée du serveur)
ALERT_CRON_TOKEN=
# Destinataire par défaut si la recherche n'en précise pas
ALERT_DEFAULT_EMAIL=
# Taille maximale d'une recherche surveillée
ALERT_MAX_RESULTS=2000

# Envoi des emails (SMTP). Exemple OVH : ssl0.ovh.net, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Clé API Pappers (pour plus tard, jamais exposée au navigateur)
PAPPERS_API_KEY=
